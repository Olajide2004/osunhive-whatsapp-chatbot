# Osunhive Chatbot — environment template.
# Copy to `.env` (git-ignored) or set these as host/secret variables.

# WhatsApp number the bot runs on. Digits only, no "+".
BOT_PHONE_NUMBER=2348106439881

# Where Baileys stores its auth keys.
# Container hosts: point this at a persistent volume (default in the image).
SESSION_DIR=./session

# Optional: health endpoint port (Render/Railway/Koyeb set PORT themselves).
# Leave empty on Termux / plain VPS runs so nothing extra listens.
PORT=

# Timezone for schedules and status posts.
TZ=Africa/Lagos
